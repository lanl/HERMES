# Ignore everything in this directory by default...
*

# ...but keep this ignore file and the README
!.gitignore
!README.md

# Descend into the data subdirectories
!photons/
!pixel_hits/
!tpx3/

# Track only these specific data files (the "!" overrides the root *.tpx3 rule)
!tpx3/Example_1kHz_5frames.tpx3
!tpx3/Tantalum_IronPowder.tpx3
!photons/Tantalum_IronPowder.parquet
!pixel_hits/Tantalum_IronPowder.parquet
